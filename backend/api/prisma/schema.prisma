generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  KITCHEN_STAFF
  DELIVERY_STAFF
  CASHIER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum TrackingStatus {
  ACCEPTED
  PREPARING
  COOKING
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
}

enum KitchenPriority {
  NORMAL
  HIGH
  VIP
  EXPRESS
}

enum KitchenItemStatus {
  WAITING
  PREPARING
  READY
}

enum PaymentMethod {
  COD
  UPI
  RAZORPAY
  CASHFREE
  CASH
  CARD
  WALLET
  SPLIT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SpiceLevel {
  MILD
  MEDIUM
  HOT
  EXTRA_HOT
}

enum FoodType {
  VEG
  NON_VEG
}

enum CategoryStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  INACTIVE
  SEASONAL
}

enum CategoryBadge {
  NEW
  HOT
  BEST_SELLER
  LIMITED
  SPICY
  VEG
  NON_VEG
}

enum CategoryImageType {
  BANNER
  THUMBNAIL
  CARD
  MOBILE
  OG
  ICON
}

enum ActivitySeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
  CRITICAL
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  ONLINE_PICKUP
  STAFF_MEAL
}

enum OrderSource {
  WEBSITE
  POS
  QR_MENU
  KIOSK
}

enum PosTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  BILLING
  WAITING
}

enum PosBillStatus {
  OPEN
  HELD
  SETTLED
  VOIDED
  REFUNDED
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PosDiscountType {
  FLAT
  PERCENTAGE
  ITEM
  BILL
  HAPPY_HOUR
  COUPON
  STAFF
  MANAGER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum AnnouncementType {
  BAR
  POPUP
}

enum AnnouncementPriorityLevel {
  EMERGENCY
  DELIVERY_UPDATE
  IMPORTANT_NOTICE
  PROMOTION
  GENERAL
}

enum AnnouncementPlatform {
  WEBSITE
  ANDROID
  BOTH
}

enum PopupFrequency {
  ONCE_SESSION
  ONCE_DAY
  EVERY_VISIT
}

enum DeliveryAvailabilityStatus {
  AVAILABLE
  LIMITED_AREA
  TEMPORARILY_UNAVAILABLE
  COMING_SOON
}

enum OfferType {
  BANNER
  COUPON
  FLASH_SALE
  COMBO
  WEEKEND
}

enum NotificationType {
  ORDER_CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  OFFER
  FESTIVAL
  NEW_ORDER
  ORDER_PLACED
  CANCELLED
  NEAR_CUSTOMER
  ASSIGNED
  PICKED_UP
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum RewardTransactionType {
  EARN
  REDEEM
  ADJUST
  RESET
}

model User {
  id                   String               @id @default(uuid())
  email                String?              @unique
  phone                String?              @unique
  passwordHash         String?
  name                 String?
  googleId             String?              @unique
  isActive             Boolean              @default(true)
  isBlocked            Boolean              @default(false)
  avatarUrl            String?
  dateOfBirth          DateTime?
  loyaltyPoints        Int                  @default(0)
  loyaltyTier          LoyaltyTier          @default(BRONZE)
  tags                 String[]             @default([])
  adminNotes           String?
  preferredPayment     PaymentMethod?
  preferredDelivery    String?
  lastOrderAt          DateTime?
  roleId               String?
  role                 Role?                @relation(fields: [roleId], references: [id])
  addresses            Address[]
  orders               Order[]
  reviews              Review[]
  favorites            Favorite[]
  cart                 Cart?
  deviceTokens         DeviceToken[]
  deliveryStaff        DeliveryStaff?
  refreshTokens        RefreshToken[]
  orderStatusUpdates   OrderStatusHistory[]
  kitchenLogs          KitchenLog[]
  customerNotes        CustomerNote[]
  rewardTransactions   RewardTransaction[]
  customerActivities   CustomerActivity[]
  userCoupons          UserCoupon[]
  notifications        Notification[]
  posSessions          PosSession[]         @relation("PosCashier")
  posOrders            Order[]              @relation("PosCashierOrders")
  posDiscountsApproved PosDiscount[]        @relation("PosDiscountApprover")
  managerPinHash       String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        UserRole         @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

model Address {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName   String      @map("contact_name")
  mobileNumber  String      @map("mobile_number")
  label         String?
  line1         String
  line2         String?
  landmark      String?
  city          String
  state         String      @default("Meghalaya")
  pincode       String
  country       String      @default("India")
  latitude      Float?
  longitude     Float?
  deliveryNotes String?     @map("delivery_notes")
  addressType   AddressType @default(HOME) @map("address_type")
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        Order[]

  @@map("addresses")
}

model Branch {
  id           String              @id @default(uuid())
  name         String
  address      String
  phone        String?
  isActive     Boolean             @default(true)
  isDefault    Boolean             @default(false)
  orders       Order[]
  posFloors    PosFloor[]
  posTerminals PosTerminal[]
  posSessions  PosSession[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  locations    InventoryLocation[]

  @@map("branches")
}

model Category {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  description        String?
  imageUrl           String?
  icon               String?
  bannerUrl          String?
  thumbnailUrl       String?
  mobileImageUrl     String?
  cardImageUrl       String?
  backgroundColor    String?
  textColor          String?
  sortOrder          Int                @default(0)
  isActive           Boolean            @default(true)
  status             CategoryStatus     @default(PUBLISHED)
  badge              CategoryBadge?
  isFeatured         Boolean            @default(false)
  isPopular          Boolean            @default(false)
  isSeasonal         Boolean            @default(false)
  seasonalName       String?
  seasonalStart      DateTime?
  seasonalEnd        DateTime?
  showOnHome         Boolean            @default(true)
  showInMobileApp    Boolean            @default(true)
  showInOffers       Boolean            @default(false)
  allowOrdering      Boolean            @default(true)
  showOnWebsite      Boolean            @default(true)
  showOnPos          Boolean            @default(true)
  showOnDelivery     Boolean            @default(true)
  showOnQrMenu       Boolean            @default(true)
  gstPercent         Decimal?           @db.Decimal(5, 2)
  prepTimeMinutes    Int                @default(15)
  servingTimeMinutes Int                @default(10)
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  canonicalUrl       String?
  ogImageUrl         String?
  kitchenStationId   String?
  kitchenStation     KitchenStation?    @relation(fields: [kitchenStationId], references: [id])
  products           Product[]
  images             CategoryImage[]
  schedules          CategorySchedule[]
  settings           CategorySettings?
  analytics          CategoryAnalytics?
  logs               CategoryLog[]
  tags               CategoryTag[]
  banners            CategoryBanner[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("categories")
}

model CategoryImage {
  id         String            @id @default(uuid())
  categoryId String
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type       CategoryImageType
  url        String
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())

  @@map("category_images")
}

model CategorySchedule {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String
  startTime  String
  endTime    String
  daysOfWeek Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("category_schedule")
}

model CategorySettings {
  id         String   @id @default(uuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("category_settings")
}

model CategoryAnalytics {
  id         String   @id @default(uuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  views      Int      @default(0)
  orders     Int      @default(0)
  revenue    Decimal  @default(0) @db.Decimal(12, 2)
  conversion Decimal  @default(0) @db.Decimal(5, 2)
  popularity Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt  DateTime @updatedAt

  @@map("category_analytics")
}

model CategoryLog {
  id          String   @id @default(uuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  action      String
  description String
  userId      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("category_logs")
}

model CategoryTag {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tag        String

  @@unique([categoryId, tag])
  @@map("category_tags")
}

model CategoryBanner {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String?
  subtitle   String?
  imageUrl   String
  linkUrl    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("category_banners")
}

model Product {
  id                     String           @id @default(uuid())
  name                   String
  slug                   String           @unique
  description            String?
  price                  Decimal          @db.Decimal(10, 2)
  packingCharge          Decimal          @default(20) @db.Decimal(10, 2)
  imageUrl               String?
  categoryId             String
  category               Category         @relation(fields: [categoryId], references: [id])
  foodType               FoodType         @default(VEG)
  spiceLevel             SpiceLevel       @default(MILD)
  prepTimeMinutes        Int              @default(15)
  isAvailable            Boolean          @default(true)
  isPopular              Boolean          @default(false)
  isFeatured             Boolean          @default(false)
  isBestseller           Boolean          @default(false)
  isOnOffer              Boolean          @default(false)
  isPreOrder             Boolean          @default(false)
  isComingSoon           Boolean          @default(false)
  ingredients            String?
  nutritionInfo          String?
  stock                  Int?
  deletedAt              DateTime?
  images                 ProductImage[]
  variants               ProductVariant[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  reviews                Review[]
  favorites              Favorite[]
  recipe                 Recipe?
  promotionAnnouncements Announcement[]   @relation("AnnouncementPromotionProduct")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@map("product_images")
}

model ProductVariant {
  id          String      @id @default(uuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal     @db.Decimal(10, 2)
  isAvailable Boolean     @default(true)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("product_variants")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("cart")
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Order {
  id                   String                   @id @default(uuid())
  orderNumber          String                   @unique
  userId               String?
  user                 User?                    @relation(fields: [userId], references: [id])
  branchId             String?
  branch               Branch?                  @relation(fields: [branchId], references: [id])
  orderType            OrderType                @default(DELIVERY)
  orderSource          OrderSource              @default(WEBSITE)
  status               OrderStatus              @default(PENDING)
  trackingStatus       TrackingStatus?
  billStatus           PosBillStatus            @default(OPEN)
  customerName         String
  customerPhone        String
  deliveryAddress      String?
  deliveryLandmark     String?
  deliveryLatitude     Float?
  deliveryLongitude    Float?
  addressId            String?
  address              Address?                 @relation(fields: [addressId], references: [id])
  posTableId           String?
  posTable             PosTable?                @relation(fields: [posTableId], references: [id])
  posSessionId         String?
  posSession           PosSession?              @relation(fields: [posSessionId], references: [id])
  cashierId            String?
  cashier              User?                    @relation("PosCashierOrders", fields: [cashierId], references: [id])
  covers               Int?
  scheduledDeliveryAt  DateTime?
  rewardPointsUsed     Int                      @default(0)
  deliveryInstructions String?
  subtotal             Decimal                  @db.Decimal(10, 2)
  deliveryCharge       Decimal                  @db.Decimal(10, 2)
  packingCharge        Decimal                  @db.Decimal(10, 2)
  taxAmount            Decimal                  @default(0) @db.Decimal(10, 2)
  cgstAmount           Decimal                  @default(0) @db.Decimal(10, 2)
  sgstAmount           Decimal                  @default(0) @db.Decimal(10, 2)
  discount             Decimal                  @default(0) @db.Decimal(10, 2)
  preOrderDiscount     Decimal                  @default(0) @db.Decimal(10, 2)
  grandTotal           Decimal                  @db.Decimal(10, 2)
  packedItemCount      Int                      @default(0)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus            @default(PENDING)
  couponId             String?
  coupon               Coupon?                  @relation(fields: [couponId], references: [id])
  deliveryOtp          String?
  rejectReason         String?
  tokenNumber          Int?
  priority             KitchenPriority          @default(NORMAL)
  kitchenStartedAt     DateTime?
  kitchenCompletedAt   DateTime?
  servedAt             DateTime?
  completedAt          DateTime?
  queuePosition        Int                      @default(0)
  items                OrderItem[]
  payment              Payment?
  posPaymentLines      PosPaymentLine[]
  posDiscounts         PosDiscount[]
  deliveryTracking     DeliveryTracking?
  statusHistory        OrderStatusHistory[]
  kitchenLogs          KitchenLog[]
  emailNotifications   OrderEmailNotification[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@map("orders")
}

model OrderItem {
  id                  String            @id @default(uuid())
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant?   @relation(fields: [variantId], references: [id])
  productName         String
  variantName         String?
  quantity            Int
  unitPrice           Decimal           @db.Decimal(10, 2)
  totalPrice          Decimal           @db.Decimal(10, 2)
  unitPackingCharge   Decimal           @default(0) @db.Decimal(10, 2)
  packingCharge       Decimal           @default(0) @db.Decimal(10, 2)
  kitchenStatus       KitchenItemStatus @default(WAITING)
  specialInstructions String?

  @@map("order_items")
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  newStatus      OrderStatus
  updatedById    String?
  updatedBy      User?        @relation(fields: [updatedById], references: [id])
  remarks        String?
  createdAt      DateTime     @default(now())

  @@map("order_status_history")
}

model KitchenStation {
  id         String       @id @default(uuid())
  name       String
  slug       String       @unique
  icon       String?
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  categories Category[]
  logs       KitchenLog[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("kitchen_stations")
}

model KitchenLog {
  id            String          @id @default(uuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stationId     String?
  station       KitchenStation? @relation(fields: [stationId], references: [id])
  action        String
  performedById String?
  performedBy   User?           @relation(fields: [performedById], references: [id])
  metadata      Json?
  createdAt     DateTime        @default(now())

  @@map("kitchen_logs")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  transactionId String?
  gatewayData   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

enum OrderEmailNotificationType {
  ORDER_CONFIRMED
}

enum OrderEmailNotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

model OrderEmailNotification {
  id               String                       @id @default(uuid())
  orderId          String
  order            Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  notificationType OrderEmailNotificationType   @default(ORDER_CONFIRMED)
  status           OrderEmailNotificationStatus @default(PENDING)
  recipients       String[]
  attemptCount     Int                          @default(0)
  lastError        String?
  sentAt           DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([orderId, notificationType])
  @@map("order_email_notifications")
}

model OrderNotificationRecipient {
  id          String   @id @default(uuid())
  email       String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@map("order_notification_recipients")
}

model PaymentMethodConfig {
  id        String        @id @default(uuid())
  method    PaymentMethod @unique
  isEnabled Boolean       @default(true)
  config    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("payment_methods")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  type           CouponType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  usageLimit     Int?
  usageCount     Int          @default(0)
  expiresAt      DateTime?
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userCoupons    UserCoupon[]

  @@map("coupons")
}

model Offer {
  id              String    @id @default(uuid())
  title           String
  description     String?
  imageUrl        String?
  discountPct     Decimal?  @db.Decimal(5, 2)
  type            OfferType @default(BANNER)
  buttonLabel     String?
  buttonUrl       String?
  displayPosition String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("offers")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model Review {
  id         String   @id @default(uuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  photos     String[]
  ownerReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

model CustomerNote {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  createdById String?
  createdAt   DateTime @default(now())

  @@map("customer_notes")
}

model RewardTransaction {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  points      Int
  balance     Int
  type        RewardTransactionType
  description String?
  createdAt   DateTime              @default(now())

  @@map("customer_rewards")
}

model CustomerActivity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("customer_activity")
}

model UserCoupon {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId   String
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  usedAt     DateTime?
  expiresAt  DateTime?
  assignedAt DateTime  @default(now())

