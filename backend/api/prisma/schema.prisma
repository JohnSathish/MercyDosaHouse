// ─── Inventory Management ───────────────────────────────────────────────────

enum InventoryUnit {
  KG
  GRAM
  LITRE
  ML
  PIECE
  PACKET
  BOTTLE
  TRAY
  DOZEN
  BUNDLE
}

enum StockMovementType {
  PURCHASE
  GRN
  ADJUSTMENT_ADD
  ADJUSTMENT_REMOVE
  CONSUMPTION
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  CORRECTION
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  APPROVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum StockAdjustmentReason {
  ADD
  REMOVE
  CORRECTION
  DAMAGE
  SAMPLE
  LOSS
}

enum WasteReason {
  EXPIRED
  DAMAGED
  KITCHEN_WASTE
  SPILLAGE
  RETURNED
  QUALITY_ISSUE
}

enum InventoryItemStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum StockTransferStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum DeliveryExecutiveStatus {
  ONLINE
  OFFLINE
  BUSY
  BREAK
  INACTIVE
}

enum DeliveryAssignmentStatus {
  WAITING
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model InventoryCategory {
  id        String          @id @default(uuid())
  name      String          @unique
  slug      String          @unique
  sortOrder Int             @default(0)
  items     InventoryItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("inventory_categories")
}

model InventoryLocation {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id])
  isActive      Boolean          @default(true)
  items         InventoryItem[]
  batches       InventoryBatch[]
  transfersFrom StockTransfer[]  @relation("TransferFrom")
  transfersTo   StockTransfer[]  @relation("TransferTo")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("inventory_locations")
}

model Supplier {
  id                 String           @id @default(uuid())
  name               String
  contactPerson      String?
  phone              String?
  email              String?
  gstNumber          String?
  address            String?
  paymentTerms       String?
  outstandingBalance Decimal          @default(0) @db.Decimal(12, 2)
  isActive           Boolean          @default(true)
  items              InventoryItem[]
  purchaseOrders     PurchaseOrder[]
  batches            InventoryBatch[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("suppliers")
}

model InventoryItem {
  id             String                 @id @default(uuid())
  name           String
  sku            String                 @unique
  barcode        String?
  categoryId     String
  category       InventoryCategory      @relation(fields: [categoryId], references: [id])
  unit           InventoryUnit
  currentStock   Decimal                @default(0) @db.Decimal(12, 3)
  reservedStock  Decimal                @default(0) @db.Decimal(12, 3)
  minStock       Decimal                @default(0) @db.Decimal(12, 3)
  maxStock       Decimal                @default(0) @db.Decimal(12, 3)
  costPrice      Decimal                @default(0) @db.Decimal(10, 2)
  averageCost    Decimal                @default(0) @db.Decimal(10, 2)
  supplierId     String?
  supplier       Supplier?              @relation(fields: [supplierId], references: [id])
  locationId     String?
  location       InventoryLocation?     @relation(fields: [locationId], references: [id])
  expiryTracking Boolean                @default(false)
  status         InventoryItemStatus    @default(IN_STOCK)
  isActive       Boolean                @default(true)
  batches        InventoryBatch[]
  movements      StockMovement[]
  adjustments    StockAdjustment[]
  recipeItems    RecipeItem[]
  consumptions   InventoryConsumption[]
  wastes         InventoryWaste[]
  purchaseItems  PurchaseOrderItem[]
  grnItems       GrnItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@map("inventory_items")
}

model InventoryBatch {
  id           String             @id @default(uuid())
  itemId       String
  item         InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNumber  String
  purchaseDate DateTime           @default(now())
  expiryDate   DateTime?
  mfgDate      DateTime?
  quantity     Decimal            @db.Decimal(12, 3)
  remainingQty Decimal            @db.Decimal(12, 3)
  costPrice    Decimal            @default(0) @db.Decimal(10, 2)
  supplierId   String?
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  locationId   String?
  location     InventoryLocation? @relation(fields: [locationId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("inventory_batches")
}

model PurchaseOrder {
  id         String              @id @default(uuid())
  poNumber   String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  orderDate  DateTime            @default(now())
  subtotal   Decimal             @default(0) @db.Decimal(12, 2)
  tax        Decimal             @default(0) @db.Decimal(12, 2)
  total      Decimal             @default(0) @db.Decimal(12, 2)
  notes      String?
  items      PurchaseOrderItem[]
  grns       GoodsReceivedNote[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String        @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  quantity    Decimal       @db.Decimal(12, 3)
  rate        Decimal       @db.Decimal(10, 2)
  tax         Decimal       @default(0) @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(12, 2)
  receivedQty Decimal       @default(0) @db.Decimal(12, 3)

  @@map("purchase_items")
}

model GoodsReceivedNote {
  id            String        @id @default(uuid())
  grnNumber     String        @unique
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id])
  invoiceNumber String?
  remarks       String?
  receivedAt    DateTime      @default(now())
  items         GrnItem[]
  createdAt     DateTime      @default(now())

  @@map("goods_received")
}

model GrnItem {
  id          String            @id @default(uuid())
  grnId       String
  grn         GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem     @relation(fields: [itemId], references: [id])
  receivedQty Decimal           @db.Decimal(12, 3)
  damagedQty  Decimal           @default(0) @db.Decimal(12, 3)
  acceptedQty Decimal           @db.Decimal(12, 3)
  rejectedQty Decimal           @default(0) @db.Decimal(12, 3)

  @@map("grn_items")
}

model StockMovement {
  id        String            @id @default(uuid())
  itemId    String
  item      InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Decimal           @db.Decimal(12, 3)
  beforeQty Decimal           @db.Decimal(12, 3)
  afterQty  Decimal           @db.Decimal(12, 3)
  reason    String?
  reference String?
  userId    String?
  createdAt DateTime          @default(now())

  @@map("stock_movements")
}

model StockAdjustment {
  id        String                @id @default(uuid())
  itemId    String
  item      InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Decimal               @db.Decimal(12, 3)
  reason    StockAdjustmentReason
  notes     String?
  userId    String?
  createdAt DateTime              @default(now())

  @@map("stock_adjustments")
}

model StockTransfer {
  id             String              @id @default(uuid())
  itemId         String
  fromLocationId String
  fromLocation   InventoryLocation   @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     InventoryLocation   @relation("TransferTo", fields: [toLocationId], references: [id])
  quantity       Decimal             @db.Decimal(12, 3)
  status         StockTransferStatus @default(PENDING)
  approvedById   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("stock_transfers")
}

model Recipe {
  id        String       @id @default(uuid())
  productId String       @unique
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  items     RecipeItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("recipe_master")
}

model RecipeItem {
  id       String        @id @default(uuid())
  recipeId String
  recipe   Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id])
  quantity Decimal       @db.Decimal(12, 3)
  unit     InventoryUnit

  @@unique([recipeId, itemId])
  @@map("recipe_items")
}

model InventoryConsumption {
  id        String        @id @default(uuid())
  orderId   String
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  quantity  Decimal       @db.Decimal(12, 3)
  createdAt DateTime      @default(now())

  @@map("inventory_consumption")
}

model InventoryWaste {
  id        String        @id @default(uuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  quantity  Decimal       @db.Decimal(12, 3)
  reason    WasteReason
  costLoss  Decimal       @default(0) @db.Decimal(10, 2)
  notes     String?
  userId    String?
  createdAt DateTime      @default(now())

  @@map("inventory_waste")
}

model InventoryAudit {
  id          String   @id @default(uuid())
  locationId  String?
  itemId      String?
  systemQty   Decimal  @db.Decimal(12, 3)
  physicalQty Decimal  @db.Decimal(12, 3)
  difference  Decimal  @db.Decimal(12, 3)
  status      String   @default("PENDING")
  notes       String?
  auditedById String?
  createdAt   DateTime @default(now())

  @@map("inventory_audit")
}

model PosFloor {
  id         String     @id @default(uuid())
  branchId   String
  branch     Branch     @relation(fields: [branchId], references: [id])
  name       String
  layoutJson Json?
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  tables     PosTable[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("pos_floors")
}

model PosTable {
  id           String         @id @default(uuid())
  floorId      String
  floor        PosFloor       @relation(fields: [floorId], references: [id], onDelete: Cascade)
  label        String
  capacity     Int            @default(4)
  status       PosTableStatus @default(AVAILABLE)
  posX         Int            @default(0)
  posY         Int            @default(0)
  mergedIntoId String?
  mergedInto   PosTable?      @relation("TableMerge", fields: [mergedIntoId], references: [id])
  mergedTables PosTable[]     @relation("TableMerge")
  qrCode       String?
  orders       Order[]
  holdBills    PosHoldBill[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([floorId, label])
  @@map("pos_tables")
}

model PosTerminal {
  id        String       @id @default(uuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id])
  name      String
  deviceKey String       @unique
  isActive  Boolean      @default(true)
  sessions  PosSession[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("pos_terminals")
}

model PosSession {
  id            String           @id @default(uuid())
  branchId      String
  branch        Branch           @relation(fields: [branchId], references: [id])
  terminalId    String?
  terminal      PosTerminal?     @relation(fields: [terminalId], references: [id])
  cashierId     String
  cashier       User             @relation("PosCashier", fields: [cashierId], references: [id])
  status        PosSessionStatus @default(OPEN)
  openingFloat  Decimal          @default(0) @db.Decimal(10, 2)
  closingCash   Decimal?         @db.Decimal(10, 2)
  cashIn        Decimal          @default(0) @db.Decimal(10, 2)
  cashOut       Decimal          @default(0) @db.Decimal(10, 2)
  totalSales    Decimal          @default(0) @db.Decimal(10, 2)
  totalRefunds  Decimal          @default(0) @db.Decimal(10, 2)
  totalDiscount Decimal          @default(0) @db.Decimal(10, 2)
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  orders        Order[]
  holdBills     PosHoldBill[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("pos_sessions")
}

model PosHoldBill {
  id          String     @id @default(uuid())
  sessionId   String
  session     PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tableId     String?
  table       PosTable?  @relation(fields: [tableId], references: [id])
  orderId     String?
  payloadJson Json
  label       String?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("pos_hold_bills")
}

model PosPaymentLine {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  createdAt DateTime      @default(now())

  @@map("pos_payment_lines")
}

model PosDiscount {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type         PosDiscountType
  amount       Decimal         @db.Decimal(10, 2)
  reason       String?
  approvedById String?
  approvedBy   User?           @relation("PosDiscountApprover", fields: [approvedById], references: [id])
  createdAt    DateTime        @default(now())

  @@map("pos_discounts")
}

model PosCashTransaction {
  id        String   @id @default(uuid())
  sessionId String
  type      String
  amount    Decimal  @db.Decimal(10, 2)
  reason    String?
  userId    String?
  createdAt DateTime @default(now())

  @@map("pos_cash_transactions")
}

model PosOfflineQueue {
  id          String    @id @default(uuid())
  terminalId  String
  payloadJson Json
  status      String    @default("PENDING")
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@map("pos_offline_queue")
}
