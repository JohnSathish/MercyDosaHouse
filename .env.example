# =============================================================================
# Mercy Dosa House — Production Environment Variables
# =============================================================================
# Copy to `.env` on your VPS. NEVER commit `.env` to Git.
# Production domain: https://mercydosahouse.com
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/mdh?schema=public

# ── Redis (required in production for OTP, sessions, queues) ─────────────────
REDIS_URL=redis://redis:6379

# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_48_CHAR_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── API Server ───────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=https://mercydosahouse.com,https://www.mercydosahouse.com,https://admin.mercydosahouse.com

# ── Public URLs (build-time for Next.js apps) ────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mercydosahouse.com
NEXT_PUBLIC_WEBSITE_URL=https://mercydosahouse.com
NEXT_PUBLIC_ADMIN_URL=https://admin.mercydosahouse.com
NEXT_PUBLIC_API_URL=https://mercydosahouse.com/api/v1
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
STORAGE_PUBLIC_URL=https://mercydosahouse.com/uploads

# ── Google OAuth (optional — customer/admin Google sign-in) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Maps (optional — address autocomplete) ────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── SMS / OTP Provider — CONFIGURATION PENDING ───────────────────────────────
# Set SMS_PROVIDER and provider credentials when ready. Until configured,
# phone OTP returns "Verification service temporarily unavailable".
# Supported: msg91 | twilio | fast2sms | none
SMS_PROVIDER=none

# Temporary demo OTP (always 123456, no SMS). Set false when SMS provider is live.
OTP_DEMO_MODE=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MDHOSA
MSG91_OTP_TEMPLATE_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Fast2SMS
FAST2SMS_API_KEY=

# ── Email Provider — CONFIGURATION PENDING ───────────────────────────────────
# Set EMAIL_PROVIDER and credentials when ready. Until configured, emails are
# skipped gracefully without blocking orders.
# Supported: smtp | resend | none
EMAIL_PROVIDER=smtp
EMAIL_FROM=Mercy Dosa House <contact@mercydosahouse.com>

# Comma-separated business recipients for new order confirmation emails
ORDER_NOTIFICATION_RECIPIENTS=johnsathish16@gmail.com,nambikaimary96@gmail.com,alboraja@gmail.com

# Admin panel URL (used in order email CTA links)
ADMIN_URL=https://admin.mercydosahouse.com

# Resend (recommended)
RESEND_API_KEY=

# SMTP — Hostinger (contact@mercydosahouse.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@mercydosahouse.com
SMTP_PASS=
# Set SMTP_TLS_REJECT_UNAUTHORIZED=false only if your host uses a self-signed cert
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ── Payment Gateways — CONFIGURATION PENDING ─────────────────────────────────
# COD works without gateway credentials. Online payments require setup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Coexist mode — localhost ports (host nginx proxies to these; avoids conflicts on shared VPS)
MDH_WEBSITE_PORT=13000
MDH_API_PORT=13001
MDH_ADMIN_PORT=13002

# Docker first-deploy only — set RUN_SEED=true once, then remove
RUN_SEED=false

# ── Push Notifications (optional) ────────────────────────────────────────────
FCM_SERVER_KEY=

# ── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# ── Initial Admin (first deploy seed only — change password after login) ─────
SEED_ADMIN_EMAIL=admin@mercydosahouse.com
SEED_ADMIN_PASSWORD=CHANGE_ME_AFTER_FIRST_LOGIN

# ── Mobile App (Expo) ────────────────────────────────────────────────────────
# mobile/customer/.env
EXPO_PUBLIC_API_URL=https://mercydosahouse.com/api/v1
EXPO_PUBLIC_WEBSITE_URL=https://mercydosahouse.com
