# Local development — copy to `.env` at repo root
# Production values: see `.env.example` (use https://mercydosahouse.com)

DATABASE_URL=postgresql://mdh:mdhsecret@localhost:5432/mdh?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-secret-min-32-characters-long!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

UPLOAD_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:3001/uploads

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# OTP/SMS — not required for local dev (uses OTP 123456)
SMS_PROVIDER=none

# Email — not required for local dev
EMAIL_PROVIDER=none

SEED_ADMIN_EMAIL=admin@mercydosahouse.com
SEED_ADMIN_PASSWORD=Admin@12345

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
FCM_SERVER_KEY=
