# Production (default for release APK builds)
EXPO_PUBLIC_API_URL=https://mercydosahouse.com/api/v1
EXPO_PUBLIC_WEBSITE_URL=https://mercydosahouse.com

# Same value as API ANDROID_APP_CHANNEL_SECRET. Required for release APK builds.
# Leave empty in local Expo Go (__DEV__ uses a development fallback).
ANDROID_APP_CHANNEL_SECRET=

# Local development (emulator) — uncomment for dev only:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1
# EXPO_PUBLIC_WEBSITE_URL=http://10.0.2.2:3000

# Google Sign-In (same Web client ID as backend GOOGLE_CLIENT_ID)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
