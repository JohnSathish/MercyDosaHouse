{
  "name": "@mdh/customer-app",
  "version": "1.0.8",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build --platform android --profile testing --local",
    "build:android:cloud": "eas build --platform android --profile testing",
    "build:android:production": "eas build --platform android --profile production --non-interactive",
    "submit:android": "eas submit --platform android --profile production --latest",
    "export": "expo export --platform android",
    "bundle:android": "node scripts/prepare-android-bundle.js",
    "apk": "pnpm prebuild:android && pnpm bundle:android && cd android && gradlew.bat assembleRelease -x createBundleReleaseJsAndAssets",
    "prebuild:android": "expo prebuild --platform android --clean",
    "eas-build-post-install": "cd ../.. && pnpm --filter @mdh/types build && pnpm --filter @mdh/utils build && pnpm --filter @mdh/mobile-shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit --skipLibCheck 2>nul || exit 0",
    "lint": "echo ok"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "~5.0.5",
    "@mdh/mobile-shared": "workspace:*",
    "@mdh/types": "workspace:*",
    "@mdh/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@tanstack/react-query": "^5.81.2",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-auth-session": "~6.2.1",
    "expo-build-properties": "~0.14.8",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-location": "^18.1.6",
    "expo-modules-autolinking": "2.1.15",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "^13.1.6",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "^1.20.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.0.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "^5.8.3"
  }
}
