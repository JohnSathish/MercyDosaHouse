{
  "name": "mercy-dosa-house",
  "private": true,
  "version": "0.1.0",
  "description": "Mercy Dosa House — Restaurant Ordering Platform",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:core": "pnpm --filter @mdh/types build && pnpm --parallel --filter @mdh/api --filter @mdh/website --filter @mdh/admin run dev",
    "dev:pos": "pnpm --filter @mdh/pos dev",
    "dev:website": "pnpm --filter @mdh/website dev",
    "dev:api": "pnpm --filter @mdh/api dev",
    "dev:mobile": "pnpm --filter @mdh/mobile-shared build && pnpm --filter @mdh/customer-app start",
    "build:mobile": "pnpm --filter @mdh/types build && pnpm --filter @mdh/mobile-shared build && pnpm --filter @mdh/customer-app export",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:prelaunch": "node e2e/pre-launch.mjs",
    "db:generate": "pnpm --filter @mdh/api exec prisma generate",
    "db:migrate": "pnpm --filter @mdh/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @mdh/api exec prisma db seed",
    "db:push": "pnpm --filter @mdh/api exec prisma db push",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "sharp"
    ],
    "overrides": {
      "@mdh/customer-app>react": "18.3.1",
      "@mdh/customer-app>@types/react": "~18.3.12",
      "@mdh/customer-app>react-dom": "18.3.1"
    }
  }
}
