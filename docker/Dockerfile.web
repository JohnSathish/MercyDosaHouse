FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate
WORKDIR /app

ARG APP_NAME=website
ARG APP_PORT=3000

FROM base AS builder
ARG APP_NAME=website
ARG APP_PORT=3000
ARG NEXT_PUBLIC_API_URL=https://mercydosahouse.com/api/v1
ARG NEXT_PUBLIC_SITE_URL=https://mercydosahouse.com
ARG NEXT_PUBLIC_WEBSITE_URL=https://mercydosahouse.com
ARG NEXT_PUBLIC_ADMIN_URL=https://admin.mercydosahouse.com
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_WEBSITE_URL=$NEXT_PUBLIC_WEBSITE_URL
ENV NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL
COPY . .
RUN printf 'node-linker=hoisted\n' > .npmrc
RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @mdh/types build
RUN pnpm --filter @mdh/utils build
RUN pnpm --filter @mdh/auth-client build
RUN pnpm --filter @mdh/sdk build
RUN pnpm --filter @mdh/${APP_NAME} build

FROM base AS runner
ARG APP_NAME=website
ARG APP_PORT=3000
ENV NODE_ENV=production
ENV PORT=${APP_PORT}
ENV APP_NAME=${APP_NAME}
WORKDIR /app
COPY --from=builder /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=builder /app/apps/${APP_NAME}/public ./apps/${APP_NAME}/public

EXPOSE ${APP_PORT}
CMD ["sh", "-c", "node apps/${APP_NAME}/server.js"]
