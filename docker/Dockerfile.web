FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate
WORKDIR /app

ARG APP_NAME=website
ARG APP_PORT=3000

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/${APP_NAME}/package.json ./apps/${APP_NAME}/
COPY packages/ui/package.json ./packages/ui/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/auth-client/package.json ./packages/auth-client/
RUN pnpm install --frozen-lockfile || pnpm install

FROM base AS builder
ARG APP_NAME=website
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @mdh/types build
RUN pnpm --filter @mdh/utils build
RUN pnpm --filter @mdh/auth-client build
RUN pnpm --filter @mdh/sdk build
RUN pnpm --filter @mdh/${APP_NAME} build

FROM base AS runner
ARG APP_NAME=website
ARG APP_PORT=3000
ENV NODE_ENV=production
ENV PORT=${APP_PORT}
WORKDIR /app
COPY --from=builder /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=builder /app/apps/${APP_NAME}/public ./apps/${APP_NAME}/public

EXPOSE ${APP_PORT}
CMD ["node", "apps/website/server.js"]
