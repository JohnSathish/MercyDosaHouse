FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate
WORKDIR /app

FROM base AS builder
COPY . .
RUN printf 'node-linker=hoisted\n' > .npmrc
RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm --filter @mdh/types build
RUN pnpm --filter @mdh/utils build
RUN cd backend/api && npx prisma generate
RUN cd backend/api && npx tsc -p prisma/tsconfig.json
RUN pnpm --filter @mdh/api build

FROM base AS runner
ENV NODE_ENV=production
RUN apk add --no-cache wget openssl
WORKDIR /app
COPY --from=builder /app/backend/api/dist ./dist
COPY --from=builder /app/backend/api/package.json ./
COPY --from=builder /app/backend/api/prisma ./prisma
COPY --from=builder /app/node_modules ./node_modules
# Workspace packages — node_modules symlinks break in runtime image
COPY --from=builder /app/packages/types/package.json ./node_modules/@mdh/types/package.json
COPY --from=builder /app/packages/types/dist ./node_modules/@mdh/types/dist
COPY --from=builder /app/packages/utils/package.json ./node_modules/@mdh/utils/package.json
COPY --from=builder /app/packages/utils/dist ./node_modules/@mdh/utils/dist
RUN find prisma/migrations -name 'migration.sql' -exec sed -i '1s/^\xEF\xBB\xBF//' {} + 2>/dev/null || true
RUN mkdir -p /app/uploads

EXPOSE 3001
CMD ["sh", "-c", "echo '=== MDH API startup ===' && npx prisma migrate deploy && if [ \"$RUN_SEED\" = \"true\" ]; then echo 'Running seed...' && node prisma/seed.js; else echo 'Skipping seed'; fi && exec node dist/main.js"]
